{
  "name": "otato-prompt-website",
  "main": "worker.mjs",
  "account_id": "5de6d827a228377db32730376e2e9b28",
  "compatibility_date": "2026-10-04",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../.build/website",
    "binding": "ASSETS",
    "run_worker_first": ["/api/downloads"],
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "prompt.otato.art", "custom_domain": true }
  ]
}
